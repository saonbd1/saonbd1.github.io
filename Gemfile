source "https://rubygems.org"

# Local preview only. The branch-based GitHub Pages build ignores this file and
# uses its own pinned gem set (github-pages), so Gemfile.lock stays out of git.
# See README.md -> "Local development".
gem "jekyll", "~> 4.4"

# Required because _config.yml sets `theme: minima`.
# The site ships its own _layouts/default.html and assets/site.css, so the theme
# is only a fallback, but Jekyll still needs the gem to be resolvable.
gem "minima", "~> 2.5"
